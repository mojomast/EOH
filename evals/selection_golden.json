{
  "version": 1,
  "note": "Natural-language tasks for every composable op. arguments is the reference call. shape is what a live model must satisfy (a bit looser than the reference).",
  "tasks": [
    {
      "id": "fly-tokyo-nvg",
      "task": "fly to Tokyo NVG",
      "expect": {
        "tool": "godseye_view",
        "op": "fly",
        "arguments": {
          "op": "fly",
          "query": "Tokyo",
          "style": "surveillance"
        },
        "shape": {
          "required": [
            "style"
          ],
          "fields": {
            "style": {
              "enum": [
                "surveillance",
                "nvg",
                "night",
                "night vision",
                "night-vision",
                "nightvision"
              ]
            }
          },
          "one_of": [
            {
              "query": {
                "type": "string",
                "contains": "tokyo"
              }
            },
            {
              "locationId": {
                "enum": [
                  "tokyo"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "id": "what-am-i-looking-at",
      "task": "what am I looking at",
      "expect": {
        "tool": "godseye_query",
        "op": "context",
