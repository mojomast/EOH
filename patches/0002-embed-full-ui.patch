From 831f0263da47d3f6e816299024a00f81ffe07a58 Mon Sep 17 00:00:00 2001
From: mojomast <mojomast@users.noreply.github.com>
Date: Wed, 4 Nov 2026 22:06:01 -0500
Subject: [PATCH 1/3] Embed: opt-in full interface (GEV_EMBED_FULL_UI)

---
 changelog.d/embed-full-ui.md |  4 ++++
 src/app/embed.js             | 15 +++++++++++++--
 src/app/embed.test.mjs       | 32 ++++++++++++++++++++++++++++++++
 3 files changed, 49 insertions(+), 2 deletions(-)
 create mode 100644 changelog.d/embed-full-ui.md

diff --git a/changelog.d/embed-full-ui.md b/changelog.d/embed-full-ui.md
new file mode 100644
index 0000000..80e5a8d
--- /dev/null
+++ b/changelog.d/embed-full-ui.md
@@ -0,0 +1,4 @@
+- Embedding pages can opt in to the full app interface instead of the clean
+  globe by setting `globalThis.GEV_EMBED_FULL_UI = true` before the app loads
+  (for example an MCP Apps host with room for the controls). Unset keeps
+  embeds clean.
diff --git a/src/app/embed.js b/src/app/embed.js
index 21e685a..5bc742a 100644
--- a/src/app/embed.js
+++ b/src/app/embed.js
@@ -40,6 +40,15 @@ export function isEmbedded(location = globalThis.location) {
   );
 }
 
+/**
+ * Whether an embedding page asked for the full app interface instead of the
+ * clean globe: opt-in, set by the page as `globalThis.GEV_EMBED_FULL_UI`
+ * before the app loads (for hosts with room for the app's own controls).
+ */
+export function isEmbeddedFullUi() {
+  return globalThis.GEV_EMBED_FULL_UI === true;
+}
+
 /** Whether a panel page loaded the app into itself. */
 export function isEmbeddedInline() {
   return globalThis.GEV_EMBED_INLINE === true;
@@ -263,8 +272,10 @@ export function installViews({
     });
   if (!isEmbedded(location)) return () => {};
 
-  windowRef.document.body.classList.add('ui-embed');
-  shell.setCleanView?.(true);
+  if (!isEmbeddedFullUi()) {
+    windowRef.document.body.classList.add('ui-embed');
+    shell.setCleanView?.(true);
+  }
   const stopRendering = isEmbeddedInline()
     ? keepPanelRendering(viewer, { windowRef })
     : () => {};
diff --git a/src/app/embed.test.mjs b/src/app/embed.test.mjs
index 5fa9493..f0a4141 100644
--- a/src/app/embed.test.mjs
+++ b/src/app/embed.test.mjs
@@ -393,3 +393,35 @@ test('a followed aircraft owns the camera, and cockpit view is entered after it'
     /no cockpit view/,
   );
 });
+
+test('an embedding page can opt in to the full interface', async () => {
+  const parent = { postMessage: () => {} };
+  const windowRef = new EventTarget();
+  windowRef.parent = parent;
+  windowRef.document = { body: { classList: new Set() } };
+  windowRef.document.body.classList.add = Set.prototype.add;
+  const shell = {
+    initialRestorePromise: Promise.resolve(),
+    clean: null,
+    setCleanView(value) {
+      this.clean = value;
+    },
+  };
+  globalThis.GEV_EMBED_FULL_UI = true;
+  try {
+    const remove = installViews({
+      shell,
+      viewer: fakeViewer(),
+      dataManager: fakeLayers(new Set()),
+      run: recorder().run,
+      location: { search: '?embed=1', hash: '' },
+      windowRef,
+    });
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    assert.equal(shell.clean, null);
+    assert.equal(windowRef.document.body.classList.has('ui-embed'), false);
+    remove();
+  } finally {
+    delete globalThis.GEV_EMBED_FULL_UI;
+  }
+});
-- 
2.47.3

